<?xml version="1.0" encoding="utf-8"?>
<!-- Colours set here, as on the start screen: AppTheme is the dark Theme.AppCompat -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Primary"
    tools:context=".CreditsActivity">

    <LinearLayout
        android:id="@+id/credits_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/credits_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Credits and licences"
            android:textColor="@color/PrimaryDark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/credits_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/PrimaryDark"
            android:textColorLink="@color/blue_dark"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
