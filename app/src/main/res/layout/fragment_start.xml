<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Primary"
    tools:context=".MainStartFragment">

    <!-- Scrolls on small screens instead of running into the art below -->
    <ScrollView
        android:id="@+id/top_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/support_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/gaku_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="学"
                android:textColor="@color/PrimaryDark"
                android:textSize="96sp" />

            <TextView
                android:id="@+id/gaku_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Japanese OCR Dictionary"
                android:textColor="@color/PrimaryDark"
                android:textSize="20sp" />

            <!-- What Gaku is doing, and the buttons that apply (MainStartFragment.refreshState). Right under
                 the title, so they're in view without scrolling even on 640dp-tall screens -->
            <TextView
                android:id="@+id/gaku_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/PrimaryDark"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/gaku_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/gaku_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gaku_button_start" />

                <Button
                    android:id="@+id/gaku_show_hide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/gaku_button_hide" />

                <Button
                    android:id="@+id/gaku_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/gaku_button_stop" />

            </LinearLayout>

            <TextView
                android:id="@+id/gaku_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/PrimaryDark"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- The Ollama server that Translate and Ask use (lan build only, MainStartFragment.setupLlm) -->
            <LinearLayout
                android:id="@+id/llm_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ollama server"
                    android:textColor="@color/PrimaryDark"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Light, like the screen: AppTheme is dark, so the text would be white -->
                    <EditText
                        android:id="@+id/llm_server"
                        android:theme="@style/ThemeOverlay.AppCompat.Light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="192.168.1.10 or https://…"
                        android:imeOptions="actionDone|flagNoPersonalizedLearning"
                        android:inputType="textUri"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/llm_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/llm_button_connect" />

                </LinearLayout>

                <!-- Sent as a bearer token, for hosted servers that need one -->
                <EditText
                    android:id="@+id/llm_api_key"
                    android:theme="@style/ThemeOverlay.AppCompat.Light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="API key (optional)"
                    android:imeOptions="actionDone|flagNoPersonalizedLearning"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <!-- The server's models, once Connect has listed them -->
                <Spinner
                    android:id="@+id/llm_model"
                    android:theme="@style/ThemeOverlay.AppCompat.Light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/llm_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/PrimaryDark"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Adding words to AnkiDroid, in both builds (MainStartFragment.refreshAnki) -->
            <LinearLayout
                android:id="@+id/anki_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anki"
                    android:textColor="@color/PrimaryDark"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- AnkiDroid's decks, once Gaku may read them -->
                    <Spinner
                        android:id="@+id/anki_deck"
                        android:theme="@style/ThemeOverlay.AppCompat.Light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/anki_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/anki_button_connect" />

                </LinearLayout>

                <TextView
                    android:id="@+id/anki_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/PrimaryDark"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/gaku_tutorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:text="Tap Here to View Tutorial"
                android:textColor="@color/blue_dark"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/gaku_github"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Dev? GitHub Here"
                android:textColor="@color/blue_dark"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/support_text"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="15dp"
        android:gravity="center"
        android:textColor="@color/PrimaryDark"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/horizontal_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="300dp"
        android:layout_height="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/horizontal_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Shown while Gaku is starting -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="300dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/horizontal_line"
        android:layout_width="300dp"
        android:layout_height="1dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toTopOf="@+id/promoView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    </FrameLayout>

    <FrameLayout
        android:id="@+id/promoView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/saeView"
            android:layout_width="300dp"
            android:layout_height="250dp"
            android:background="@android:color/holo_red_dark"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
