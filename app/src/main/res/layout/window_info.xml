<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/info_window"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_solid_border_corners_0_white_black_round">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp">

                <!-- The arrows are INVISIBLE rather than GONE when not needed, so the grid's width (and
                     so how many characters fit) doesn't depend on them -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/info_prev"
                        style="@style/InfoButton"
                        android:layout_marginEnd="0dp"
                        android:visibility="invisible"
                        android:text="‹" />

                    <ca.fuwafuwa.gaku.Windows.Views.KanjiGridView
                        android:id="@+id/kanji_grid"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp" />

                    <TextView
                        android:id="@+id/info_next"
                        style="@style/InfoButton"
                        android:layout_marginEnd="0dp"
                        android:visibility="invisible"
                        android:text="›" />

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp">

                    <!-- Scrolls sideways where the buttons don't all fit (phones in portrait), with the
                         close button always in view -->
                    <HorizontalScrollView
                        android:id="@+id/info_buttons_scroll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/info_translate"
                                style="@style/InfoButton"
                                android:text="Translate" />

                            <!-- lan build with an Ollama server set: Translate asks the LLM, so these open
                                 Google Translate and the chat window -->
                            <TextView
                                android:id="@+id/info_google"
                                style="@style/InfoButton"
                                android:visibility="gone"
                                android:text="Google" />

                            <TextView
                                android:id="@+id/info_ask"
                                style="@style/InfoButton"
                                android:visibility="gone"
                                android:text="Ask" />

                            <TextView
                                android:id="@+id/info_copy"
                                style="@style/InfoButton"
                                android:text="Copy" />

                            <!-- Adds the word looked up to AnkiDroid; shown once it's connected on the
                                 start screen -->
                            <TextView
                                android:id="@+id/info_anki"
                                style="@style/InfoButton"
                                android:visibility="gone"
                                android:text="Anki" />

                            <!-- Reads the same crop with the other reader; hidden for text looked up from
                                 another app, which has no image -->
                            <TextView
                                android:id="@+id/info_read_again"
                                style="@style/InfoButton"
                                android:text="Read with ML Kit" />

                            <TextView
                                android:id="@+id/info_instant"
                                style="@style/InfoButton"
                                android:text="Instant: off" />

                        </LinearLayout>

                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/info_close"
                        style="@style/InfoButton"
                        android:layout_marginEnd="0dp"
                        android:text="✕" />

                </LinearLayout>

                <!-- Actions for the character last tapped in the grid -->
                <LinearLayout
                    android:id="@+id/info_char_actions"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/info_char"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:textSize="24sp"
                        android:textColor="@android:color/black" />

                    <!-- Lookalike characters to swap in, filled in code. Scrolls sideways when they don't
                         fit, so Edit and Delete stay on screen. -->
                    <HorizontalScrollView
                        android:id="@+id/info_char_choices_scroll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/info_char_choices"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/info_char_edit"
                        style="@style/InfoButton"
                        android:text="Edit" />

                    <TextView
                        android:id="@+id/info_char_delete"
                        style="@style/InfoButton"
                        android:text="Delete" />

                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:animateLayoutChanges="true"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/info_text"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- The LLM's translation (lan build), kept while characters are looked up -->
                        <TextView
                            android:id="@+id/info_llm_translation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <TextSwitcher
                            android:id="@+id/dict_results"
                            android:measureAllChildren="false"
                            android:animateLayoutChanges="true"
                            android:inAnimation="@anim/slide_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@android:color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:textColor="@android:color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </TextSwitcher>

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

